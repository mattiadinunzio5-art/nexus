# URL pubblico del sito (per sitemap, canonical e Open Graph).
# Su Vercel, se assente, viene usato automaticamente l'indirizzo di produzione del progetto.
SITE_URL=

# Supabase Auth (facoltativo). Senza questi valori la sezione Access dichiara che la
# registrazione non è ancora attiva: nessun login viene simulato.
# Dashboard Supabase → Project Settings → API. La "anon public key" è pubblica per natura;
# NON inserire mai la service_role key in un'app frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
